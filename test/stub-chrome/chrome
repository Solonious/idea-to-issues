#!/usr/bin/env node
// A stand-in for headless Chrome. CHROME_STUB_LOG names a file that gets one JSON argv line per call;
// CHROME_STUB_FAIL=1 fails without writing the screenshot.
const { appendFileSync, writeFileSync } = require('node:fs');

const argv = process.argv.slice(2);
if (process.env.CHROME_STUB_LOG) appendFileSync(process.env.CHROME_STUB_LOG, `${JSON.stringify(argv)}\n`);
if (process.env.CHROME_STUB_FAIL) {
  process.stderr.write('stub chrome: injected failure\n');
  process.exit(1);
}
const shot = argv.find((a) => a.startsWith('--screenshot='));
if (!shot) {
  process.stderr.write('stub chrome: no --screenshot argument\n');
  process.exit(1);
}
writeFileSync(shot.slice('--screenshot='.length), 'png');
