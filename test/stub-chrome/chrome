#!/usr/bin/env node
// A stand-in for headless Chrome's DevTools pipe: commands arrive NUL-terminated on fd 3, replies go out on fd 4.
// CHROME_STUB_LOG names a file that gets a {"argv"} line per launch, then one {method, params, sessionId} line per command;
// CHROME_STUB_FAIL=1 fails at launch; CHROME_STUB_ERROR=<method> answers that method with a protocol error.
const { appendFileSync, createReadStream, writeSync } = require('node:fs');

const argv = process.argv.slice(2);
const log = (entry) => { if (process.env.CHROME_STUB_LOG) appendFileSync(process.env.CHROME_STUB_LOG, `${JSON.stringify(entry)}\n`); };
log({ argv });
if (process.env.CHROME_STUB_FAIL) {
  process.stderr.write('stub chrome: injected failure\n');
  process.exit(1);
}
if (!argv.includes('--remote-debugging-pipe')) {
  process.stderr.write('stub chrome: no --remote-debugging-pipe argument\n');
  process.exit(1);
}

const out = (msg) => writeSync(4, `${JSON.stringify(msg)}\0`);
const results = {
  'Target.createTarget': { targetId: 'T1' },
  'Target.attachToTarget': { sessionId: 'S1' },
  'Page.navigate': { frameId: 'F1' },
  'Page.captureScreenshot': { data: Buffer.from('png').toString('base64') },
};

let buf = '';
createReadStream(null, { fd: 3 }).on('data', (chunk) => {
  buf += chunk;
  let end;
  while ((end = buf.indexOf('\0')) !== -1) {
    const raw = buf.slice(0, end);
    buf = buf.slice(end + 1);
    if (!raw) continue;
    const { id, method, params, sessionId } = JSON.parse(raw);
    log({ method, params, sessionId });
    const echo = sessionId ? { sessionId } : {};
    if (process.env.CHROME_STUB_ERROR === method) {
      out({ id, error: { code: -32000, message: `stub chrome: injected ${method} error` }, ...echo });
      continue;
    }
    out({ id, result: results[method] ?? {}, ...echo });
    if (method === 'Page.navigate') out({ method: 'Page.loadEventFired', params: { timestamp: 0 }, ...echo });
    if (method === 'Browser.close') process.exit(0);
  }
});
